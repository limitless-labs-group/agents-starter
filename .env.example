# agents-starter environment. Copy to .env (npm run init does this), fill in, never commit.
# Verify everything with: npm run doctor

# ── Required for every strategy ──────────────────────────────────────────────

# Dedicated trading EOA. NOT your main wallet. Signs EIP-712 orders on Base
# (and Polygon hedges for cross-market-mm). Fund it with USDC on Base + a little ETH.
PRIVATE_KEY=0x...

# Limitless scoped HMAC token. limitless.exchange → connect the SAME wallet as
# PRIVATE_KEY → API token modal → "API Tokens" → Derive → copy both values.
# Decline the one-time "1-click trading" prompt: self-signed orders need EOA mode
# (fix later with: npm start wallet-mode eoa). Headless/CI: npm run derive-token
LMTS_TOKEN_ID=your-token-id
LMTS_TOKEN_SECRET=your-base64-secret

# Safety. true = every order intent is logged, nothing is signed or sent.
# Keep true until you have watched a clean dry run. Never leave live unattended
# without the strategy's own risk limits set.
DRY_RUN=true

# ── Optional ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info   # trace | debug | info | warn | error | fatal

# Endpoint overrides. Defaults are production; there is no testnet or sandbox.
# LIMITLESS_API_URL=https://api.limitless.exchange
# LIMITLESS_WS_URL=wss://ws.limitless.exchange

# Legacy X-API-Key. Only if you already hold one; new setups use the token above.
# LIMITLESS_API_KEY=

# ── Strategy tunables (all optional, defaults in each strategy's run.ts) ─────

# template          TEMPLATE_MIN_EDGE, TEMPLATE_ORDER_USD, TEMPLATE_MAX_POSITIONS, TEMPLATE_MAX_MINUTES
# certainty-closer  CC_MIN_LEAD, CC_MAX_LEAD, CC_MAX_MINUTES, CC_ASSUMED_EDGE, CC_BANKROLL, CC_KELLY_FRACTION, CC_MAX_RISK, CC_MAX_POSITIONS
# oracle-arb        ORACLE_ASSETS, ORACLE_MIN_EDGE, ORACLE_MIN_PRICE, ORACLE_MAX_PRICE, ORACLE_BET_SIZE, ORACLE_MAX_POSITIONS, ORACLE_MIN_MINUTES, ORACLE_MAX_MINUTES

# ── cross-market-mm only (Limitless ↔ Polymarket) ────────────────────────────
# Guided setup: npm run cross-market-mm:init. Strategy config lives in
# cross-market-mm.config.yaml, not here.

# Polymarket relayer key, used ONCE by `cross-market-mm:setup-poly` to deploy
# your deposit wallet; the running bot derives Poly creds from PRIVATE_KEY.
# Source: Polymarket builder dashboard. ADDRESS = your EOA's 0x address.
# RELAYER_API_KEY=your-relayer-api-key
# RELAYER_API_KEY_ADDRESS=0xyour-eoa-address

# Data + config paths. Set DATA_DIR ABSOLUTE so the Academy operator panel can
# point at the same directory.
# CROSS_MARKET_MM_DATA_DIR=/abs/path/to/agents-starter/data
# CROSS_MARKET_MM_CONFIG_PATH=./cross-market-mm.config.yaml

# Telegram push (optional). The bot always writes data/cross-market-mm-status.json.
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...   # @BotFather
# TELEGRAM_CHAT_ID=123456789               # @userinfobot

# Polymarket endpoint overrides.
# POLYMARKET_CLOB_URL / POLYMARKET_GAMMA_URL / POLYMARKET_DATA_URL / POLYMARKET_WS_URL
