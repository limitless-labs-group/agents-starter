{
  "name": "agents-starter",
  "version": "2.0.0",
  "description": "Boilerplate for autonomous trading agents on Limitless Exchange (Base) — official SDK, HMAC auth, dry-run by default",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "init": "tsx src/scripts/init.ts",
    "doctor": "tsx src/index.ts doctor",
    "start": "tsx src/index.ts",
    "template": "tsx src/strategies/template/run.ts",
    "certainty-closer": "tsx src/strategies/certainty-closer/run.ts",
    "oracle-arb": "tsx src/strategies/oracle-arb/run.ts",
    "cross-market-mm": "tsx src/strategies/cross-market-mm/run.ts",
    "cross-market-mm:init": "tsx src/strategies/cross-market-mm/init.ts",
    "cross-market-mm:find-pairs": "tsx src/strategies/cross-market-mm/find-pairs.ts",
    "cross-market-mm:setup-poly": "tsx src/strategies/cross-market-mm/setup-poly-wallet.ts",
    "cross-market-mm:deposit": "tsx src/strategies/cross-market-mm/deposit.ts",
    "cross-market-mm:preflight": "tsx src/strategies/cross-market-mm/preflight.ts",
    "cross-market-mm:flatten": "tsx src/strategies/cross-market-mm/flatten.ts",
    "cross-market-mm:close": "tsx src/strategies/cross-market-mm/close.ts",
    "cross-market-mm:status": "tsx src/strategies/cross-market-mm/status.ts",
    "cross-market-mm:analyze": "tsx src/strategies/cross-market-mm/analyze.ts",
    "cross-market-mm:score": "tsx src/strategies/cross-market-mm/score.ts",
    "cross-market-mm:telegram-test": "tsx src/strategies/cross-market-mm/telegram-test.ts",
    "example:place-order": "tsx src/examples/place-order.ts",
    "example:stream": "tsx src/examples/stream-orderbook.ts",
    "redeem": "tsx src/core/limitless/redeem.ts",
    "derive-token": "tsx src/core/limitless/derive-token.ts"
  },
  "keywords": [
    "prediction-markets",
    "trading-bot",
    "trading-agent",
    "limitless",
    "base-chain",
    "defi",
    "mcp",
    "ai-agents"
  ],
  "author": "Limitless Labs",
  "license": "MIT",
  "dependencies": {
    "@limitless-exchange/sdk": "^1.1.0",
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client-v2": "^1.1.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "eventsource": "^4.1.0",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
